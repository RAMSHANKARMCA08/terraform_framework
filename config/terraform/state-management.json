{
  "default_backend": "postgres",
  "backends": {
    "postgres": {
      "connection_setting": "TF_STATE_CONNECTION",
      "schema_name": "{application}_{environment}"
    },
    "s3": {
      "storage_setting": "TF_STATE_STORAGE",
      "region": "us-east-1",
      "key_pattern": "{environment}/{application}.tfstate"
    }
  }
}
