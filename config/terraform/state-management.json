{
  "default_backend": "s3",
  "backends": {
    "postgres": {
      "connection_setting": "TF_STATE_CONNECTION",
      "schema_name": "{application}_{environment}"
    },
    "s3": {
      "storage_setting": "TF_STATE_STORAGE",
      "lock_table_setting": "TF_STATE_LOCK_TABLE",
      "region": "us-east-1",
      "key_pattern": "{application}/{environment}.tfstate"
    }
  }
}
