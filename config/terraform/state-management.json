{
  "default_backend": "postgres",
  "backends": {
    "postgres": {
      "connection_secret": "TF_STATE_POSTGRES_CONNECTION",
      "schema_name": "{application}_{environment}"
    },
    "s3-dynamodb": {
      "bucket_variable": "TF_STATE_BUCKET",
      "lock_table_variable": "TF_LOCK_TABLE",
      "region": "us-east-1",
      "key_pattern": "{environment}/{application}.tfstate"
    }
  }
}
